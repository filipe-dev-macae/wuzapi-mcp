{
  "MessageCarousel": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "Phone",
      "Body",
      "Cards"
    ],
    "properties": {
      "Phone": {
        "type": "string",
        "description": "Bare phone number or direct PN/LID JID; no groups, bots or device-specific JIDs",
        "example": "15555550100"
      },
      "Id": {
        "type": "string",
        "maxLength": 128,
        "description": "Optional printable ASCII without whitespace. Generated when omitted. Correlation only; reuse is not idempotency and does not replace history.",
        "example": "carousel-example-1"
      },
      "Body": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "example": "Choose a destination"
      },
      "Cards": {
        "type": "array",
        "minItems": 2,
        "maxItems": 10,
        "items": {
          "$ref": "#/definitions/CarouselCard"
        }
      }
    }
  },
  "CarouselCard": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "Body",
      "Image",
      "Buttons"
    ],
    "properties": {
      "Body": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "example": "Summit"
      },
      "Image": {
        "type": "string",
        "description": "JPEG/PNG data URL or HTTP(S) URL. Images total at most 16 MiB, 4096px per side and 16 megapixels each.",
        "example": "https://example.com/summit.jpg"
      },
      "Buttons": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "$ref": "#/definitions/CarouselButton"
        }
      }
    }
  },
  "CarouselButton": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title"
    ],
    "properties": {
      "type": {
        "type": "string",
        "enum": [
          "",
          "reply",
          "cta_url",
          "cta_call"
        ],
        "default": "reply",
        "description": "Omitted or empty type means reply."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      },
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Required for reply, without controls, unique across all cards. Omit for other actions.",
        "example": "summit"
      },
      "url": {
        "type": "string",
        "maxLength": 2048,
        "description": "Required for cta_url; absolute HTTP(S), no credentials, whitespace or controls. Omit for other actions.",
        "example": "https://example.com/summit"
      },
      "phone_number": {
        "type": "string",
        "description": "Required for cta_call; optional leading + and 6-15 digits. Omit for other actions.",
        "example": "+15555550100"
      }
    }
  }
}