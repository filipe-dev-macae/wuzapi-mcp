[Unit]
Description=WuzAPI privado
After=network-online.target

[Service]
WorkingDirectory=%h/wuzapi/current
EnvironmentFile=%h/wuzapi/secrets/wuzapi.env
ExecStart=%h/wuzapi/current/wuzapi -address=127.0.0.1 -port=8081 -datadir=%h/wuzapi/data -logtype=json -autopresence=unavailable
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
